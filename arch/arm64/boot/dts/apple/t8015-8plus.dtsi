 * Copyright (c) 2022, Konrad Dybcio <konradybcio@kernel.org>
 */

/* The 8 Plus has minor differences like 1 more camera, 1 GiB of RAM more and a bigger display. */
#include "t8015-8.dtsi"

&smc {
	smc_regulators: regulators {
		compatible = "apple,t8015-smc-regulator";

		mesa_1v8: mesa-1v8 {
			regulator-name = "mesa-1v8";
		};

		mesa_3v0: mesa-3v0 {
			regulator-name = "mesa-3v0";
		};
	};
};

&spi3 {
	status = "okay";

	/* Touch ID sensor: SPI mode 2 (clock idles high, sample on the first edge) */
	touch-id@0 {
		compatible = "apple,mesa";
		reg = <0>;
		spi-max-frequency = <4000000>;
		spi-cpol;
		vdd18-supply = <&mesa_1v8>;
		vdd30-supply = <&mesa_3v0>;
	};
};

/ {
	aliases {
		aop = &aop; /* m1n1 passes the AOP its boot arguments and calibration */
		bluetooth0 = &bluetooth; /* m1n1 adds the unit's device address */
		serial1 = &serial1;
	};
};

/* The AOP firmware comes from the IPSW (Firmware/AOP/aopfw-iphone10aop). */
&aop {
	firmware-name = "apple/aop-t8015.bin", "apple/aop-t8015-ext.bin";
	status = "okay";
};

&aop_mbox {
	status = "okay";
};

/*
 * Measured on an iPhone 8 Plus: the accelerometer reports gravity on the
 * device's axes (x right, y up, z out of the screen), as on the iPad 5 and
 * the A9 iPhones: upright y = -1 g, flat screen up z = -1 g. iio-sensor-proxy
 * takes upright as negative y and needs z flipped. The gyroscope turns
 * positive about z when the phone spins anticlockwise screen up.
 */
&aop_accel {
	mount-matrix = "1", "0", "0",
		       "0", "1", "0",
		       "0", "0", "-1";
};

&aop_gyro {
	mount-matrix = "1", "0", "0",
		       "0", "1", "0",
		       "0", "0", "1";
};

/*
 * Bluetooth: the BCM4357's Bluetooth half, on UART1 (ADT uart1/bluetooth).
 * The pins follow the ADT's function-tx (211, RX next) and function-rts
 * (213, CTS next); power is the SMC GPIO key gP09, as the Wi-Fi half's is
 * gP0e, and BT_WAKE is AP GPIO 2.
 */
&pinctrl_ap {
	bluetooth_uart1_pins: bluetooth-uart1-pins {
		pinmux = <APPLE_PINMUX(211, 1)>,
			 <APPLE_PINMUX(212, 1)>,
			 <APPLE_PINMUX(213, 1)>,
			 <APPLE_PINMUX(214, 1)>;
	};
};

&serial1 {
	pinctrl-0 = <&bluetooth_uart1_pins>;
	pinctrl-names = "default";
	uart-has-rtscts;
	status = "okay";

	bluetooth: bluetooth {
		compatible = "apple,d21-bcm4357b1-bt";
		current-speed = <115200>;
		/* UART1 runs from the 24 MHz reference: 1.5 Mbaud at most */
		max-speed = <1500000>;
		shutdown-gpios = <&smc_gpio 9 GPIO_ACTIVE_HIGH>;
		device-wakeup-gpios = <&pinctrl_ap 2 GPIO_ACTIVE_HIGH>;
	};
};
