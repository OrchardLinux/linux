#include "s5l8960x.dtsi"
#include "s5l8960x-common.dtsi"
#include "s5l8960x-opp.dtsi"
#include <dt-bindings/input/input.h>

/ {
	chassis-type = "tablet";

	gpio-keys {
		compatible = "gpio-keys";

		button-home {
			label = "Home Button";
			gpios = <&pinctrl 2 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_HOMEPAGE>;
			wakeup-source;
		};

		button-power {
			label = "Power Button";
			gpios = <&pinctrl 3 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_POWER>;
			wakeup-source;
		};

		button-voldown {
			label = "Volume Down";
			gpios = <&pinctrl 5 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_VOLUMEDOWN>;
		};

		button-volup {
			label = "Volume Up";
			gpios = <&pinctrl 4 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_VOLUMEUP>;
		};

		switch-mute {
			label = "Mute Switch";
			gpios = <&pinctrl 6 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_MUTE>;
		};
	};
};

&framebuffer0 {
	power-domains = <&ps_disp0 &ps_dp>;
};

&i2c0 {
	status = "okay";

	pmic@3c {
		compatible = "apple,anya-pmic", "apple,i2c-pmic";
		reg = <0x3c>;
		#address-cells = <1>;
		#size-cells = <1>;

		rtc@5c0 {
			compatible = "apple,anya-pmic-rtc", "apple,amber-pmic-rtc";
			reg = <0x5c0 0x10>;
			nvmem-cells = <&rtc_offset>;
			nvmem-cell-names = "rtc_offset";
		};

		backlight@600 {
			compatible = "apple,anya-pmic-bl";
			reg = <0x600 0x2>;
		};

		nvmem@4000 {
			compatible = "apple,pmic-nvmem";
			reg = <0x4000 0x28>;

			nvmem-layout {
				compatible = "fixed-layout";
				#address-cells = <1>;
				#size-cells = <1>;

				rtc_offset: rtc-offset@4 {
					reg = <0x4 0x4>;
				};
			};
		};
	};
};

/*
 * Lightning charging, at the D2089's registers as iOS 12
 * AppleD2089PMUPowerSource uses them: connection and charger state at
 * 0x60, the input-current limit at 0x4c0, the ADC at 0x500.
 */
&{/soc/i2c@20a110000/pmic@3c} {
	/* The PMU event line, from the ADT pmu node: AP GPIO 21. */
	pmu_events: interrupt-controller {
		compatible = "apple,d2089-pmic-gpio";
		interrupt-controller;
		#interrupt-cells = <2>;
		interrupts-extended = <&pinctrl 21 IRQ_TYPE_LEVEL_LOW>;
	};

	/*
	 * The ADT's charger node allows 0x960 = 2400 mA of input on every iPad mini 2 and 3.
	 * The maximum here is the highest input limit measured on an A7
	 * so far: 1050 mA (0x4e) charged a J72's battery at +279 to +423 mA
	 * under the desktop, at 36 C, in thisiscamk's ten-minute run.
	 */
	tristar_charger: charger@60 {
		compatible = "apple,d2089-tristar-charger";
		reg = <0x60 0x0d>, <0x4c0 0x01>, <0x500 0x04>;
		reg-names = "status", "control", "adc";
		interrupt-parent = <&pmu_events>;
		/*
		 * The PMU line and ADC done. No source events, as on the iPad
		 * Air 2: the charger's 100 ms poll of 0x60 sees plug and unplug.
		 */
		interrupts = <112 IRQ_TYPE_EDGE_RISING>,
			     <89 IRQ_TYPE_EDGE_RISING>;
		apple,tristar = <&tristar>;
		input-current-limit-microamp = <1050000>;

		/* The charger decides when USB data may come on. */
		port {
			tristar_charger_usb: endpoint {
				remote-endpoint = <&usbdev_role>;
			};
		};
	};
};

&i2c0 {
	status = "okay";

	/* The Lightning port controller, from the ADT i2c0/tristar node. */
	tristar: port-controller@1a {
		compatible = "nxp,cbtl1610";
		reg = <0x1a>;
	};
};

/* Tell the Lightning charger what the USB host allows. */
&usbdev {
	usb-psy-name = "lightning";
	usb-role-switch;

	port {
		usbdev_role: endpoint {
			remote-endpoint = <&tristar_charger_usb>;
		};
	};
};
