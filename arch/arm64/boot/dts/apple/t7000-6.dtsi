#include <dt-bindings/input/input.h>
#include "t7000.dtsi"
#include "t7000-common.dtsi"
#include "t7000-handheld.dtsi"
#include "t7000-bcm4345.dtsi"

/ {
	chassis-type = "handset";

	aliases {
		serial5 = &serial5;
	};

	gpio-keys {
		compatible = "gpio-keys";

		button-home {
			label = "Home Button";
			gpios = <&pinctrl 32 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_HOMEPAGE>;
			wakeup-source;
		};

		button-power {
			label = "Power Button";
			gpios = <&pinctrl 33 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_POWER>;
			wakeup-source;
		};

		button-volup {
			label = "Volume Up";
			gpios = <&pinctrl 45 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_VOLUMEUP>;
		};

		button-voldown {
			label = "Volume Down";
			gpios = <&pinctrl 46 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_VOLUMEDOWN>;
		};

		switch-mute {
			label = "Mute Switch";
			gpios = <&pinctrl 131 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_MUTE>;
		};
	};
};

/* The bq27540 gauge on UART5's HDQ line (ADT uart5/gas-gauge). */
&serial5 {
	pinctrl-0 = <&uart5_pins>;
	pinctrl-names = "default";
	status = "okay";

	hdq_onewire: onewire {
		compatible = "ti,hdq-uart";

		fuel_gauge: fuel-gauge {
			compatible = "ti,bq27540-hdq";
		};
	};
};

&framebuffer0 {
	power-domains = <&ps_disp0 &ps_mipi_dsi>;
};

&gpu {
	status = "okay";
};

&typhoon_opp06 {
	status = "okay";
};

&i2c0 {
	status = "okay";

	pmic@74 {
		compatible = "apple,adi-pmic", "apple,i2c-pmic";
		reg = <0x74>;
		#address-cells = <1>;
		#size-cells = <1>;

		pmu_gpio: gpio {
			compatible = "apple,d2186-pmic-gpio";
			gpio-controller;
			#gpio-cells = <2>;
			/* Only Bluetooth (8) and Wi-Fi (10) REG_ON are used; the others stay as iBoot left them. */
			gpio-reserved-ranges = <0 8>, <9 1>, <11 10>;
		};

		rtc@5c0 {
			compatible = "apple,adi-pmic-rtc", "apple,amber-pmic-rtc";
			reg = <0x5c0 0x10>;
			nvmem-cells = <&rtc_offset>;
			nvmem-cell-names = "rtc_offset";
		};

		/*
		 * The PMIC's housekeeping ADC, as on the iPod touch 6. The
		 * iPhone 6 has a bq27540 gauge for the battery, so no
		 * apple,d2186-battery node: it would report the same battery
		 * a second time.
		 */
		pmu_adc: adc@500 {
			compatible = "apple,d2186-adc";
			reg = <0x500 0x24>;
			#io-channel-cells = <1>;
		};

		nvmem@4000 {
			compatible = "apple,pmic-nvmem";
			reg = <0x4000 0x28>;

			nvmem-layout {
				compatible = "fixed-layout";
				#address-cells = <1>;
				#size-cells = <1>;

				rtc_offset: rtc-offset@4 {
					reg = <0x4 0x4>;
				};
			};
		};
	};
};

/* The boot loader set up the display; nothing restores it after power loss. */
&ps_disp0 {
	apple,always-on;
	apple,manual-pm;
};

&ps_mipi_dsi {
	apple,always-on;
	apple,manual-pm;
};
