/*
 * Apple iPhone 8, iPhone 8 Plus, iPhone X
 *
 * This file contains parts common to all Apple A11 devices.
 *
 * target-type: D20, D21, D22, D201, D211, D221
 *
 * Copyright (c) 2024, Nick Chan <towinchenmi@gmail.com>
 */

/ {
	aliases {
		ausbphy0 = &ausbphy0;
		serial0 = &serial0;
		/* Used by loader to fill properties*/
		smc = &smc;
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		stdout-path = "serial0";

		framebuffer0: framebuffer@0 {
			compatible = "apple,simple-framebuffer", "simple-framebuffer";
			reg = <0 0 0 0>; /* To be filled by loader */
			power-domains = <&ps_disp0_be &ps_mipi_dsi &ps_disp0_hilo &ps_disp0_ppp>;
			/* Format properties will be added by loader */
			status = "disabled";
		};
	};

	memory@800000000 {
		device_type = "memory";
		reg = <0x8 0 0 0>; /* To be filled by loader */
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/* To be filled by loader */
	};
};

&serial0 {
	status = "okay";
};

&smc_hwmon {
	temperature-TG0B {
		apple,key-id = "TG0B";
		label = "Battery Temp";
	};

	temperature-TG0V {
		apple,key-id = "TG0V";
		label = "Battery Flex Temp";
	};

	temperature-TP1d {
		apple,key-id = "TP1d";
		label = "Forehead Temp";
	};

	temperature-TP2d {
		apple,key-id = "TP2d";
		label = "Rear Camera Temp";
	};

	temperature-TP3d {
		apple,key-id = "TP3d";
		label = "Cellular Radio Temp";
	};

	temperature-TP4d {
		apple,key-id = "TP4d";
		label = "AP SoC Temp";
	};

	temperature-TP5d {
		apple,key-id = "TP5d";
		label = "Charger Temp";
	};
};

/* The boot loader set up the display; nothing restores it after power loss. */
&ps_disp0_be {
	apple,always-on;
	apple,manual-pm;
};

&ps_mipi_dsi {
	apple,always-on;
	apple,manual-pm;
};

&ps_disp0_hilo {
	apple,always-on;
	apple,manual-pm;
};

&ps_disp0_ppp {
	apple,always-on;
	apple,manual-pm;
};

/*
 * Wi-Fi, the same on every A11 iPhone (iOS 16.7.16 DeviceTree.d20ap, d201ap,
 * d21ap, d211ap, d22ap, d221ap): a BCM4357 on PCIe port 3 behind
 * dart-apcie3, PERST# on AP GPIO 167, CLKREQ# on 163, device-wake on 40, and
 * REG_ON on SMC PMU GPIO 14 ("gP0e"). brcmfmac takes the module (apolloe,
 * pegasusk, herculese, ...) from the ADT's module-instance.
 */
/ {
	aliases {
		wifi0 = &wifi0;
	};

	wlan_vdd: regulator-wlan-vdd {
		compatible = "regulator-fixed";
		regulator-name = "wlan-vdd";
		gpio = <&smc_gpio 14 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		off-on-delay-us = <2500>;
	};
};

&apcie {
	iommu-map = <0x100 &dart_apcie3 0 0x0 0x80000000 0x0 0x3ffff000 1>;
	iommu-map-mask = <0xff00>;
	pinctrl-0 = <&wifi_clkreq>;
	pinctrl-names = "default";
	status = "okay";

	port03: pci@3,0 {
		device_type = "pci";
		reg = <0x1800 0x0 0x0 0x0 0x0>;
		bus-range = <1 1>;
		max-link-speed = <2>;
		apple,manual-availability-iommu = <&dart_apcie3 0>;
		reset-gpios = <&pinctrl_ap 167 GPIO_ACTIVE_LOW>;

		#address-cells = <3>;
		#size-cells = <2>;
		ranges;

		wifi0: wifi@0,0 {
			compatible = "pci14e4,440a";
			reg = <0x10000 0x0 0x0 0x0 0x0>;
			device-wake-gpios = <&pinctrl_ap 40 GPIO_ACTIVE_HIGH>;
			vdd-supply = <&wlan_vdd>;
			brcm,ccode-map-trivial;
		};
	};
};

/* The Wi-Fi port's DART: apple-h9p reloads it by hand and needs its device. */
&dart_apcie3 {
	status = "okay";
};

&pinctrl_ap {
	wifi_clkreq: wifi-clkreq-pins {
		pinmux = <APPLE_PINMUX(163, 1)>;
	};
};
