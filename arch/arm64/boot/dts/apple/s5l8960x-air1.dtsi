/*
 * Apple iPad Air  common device tree
 * Based on A7 (APL5698), up to 1.4GHz
 *
 * Copyright (c) 2022, Konrad Dybcio <konradybcio@kernel.org>
 */

#include "s5l8960x.dtsi"
#include "s5l8960x-common.dtsi"
#include "s5l8965x-opp.dtsi"
#include <dt-bindings/input/input.h>

/ {
	chassis-type = "tablet";

	/*
	 * The speakers and the built-in microphones: the CS42L81 on SPI3
	 * (control) and MCA0 (data), as in Apple's /arm-io/spi3/audio-codec
	 * and /arm-io/mca0/audio-codec. The codec drives both speakers as one
	 * stereo pair. The two microphones are digital ones on the codec's
	 * DMIC1 pair: the audio-codec node names them dmic1a-intmic ("imic")
	 * and dmic1b-intmic ("smic"), the same in the J71 and J72 trees and
	 * the same pair the iPad 5 records from. Headphones (ADT hpout-hp,
	 * with the headset switches ext_sw1 and ext_sw2) are not described
	 * yet.
	 */
	sound {
		compatible = "simple-audio-card";
		simple-audio-card,name = "iPad Air Speakers";
		simple-audio-card,format = "i2s";
		simple-audio-card,bitclock-master = <&codec_dai>;
		simple-audio-card,frame-master = <&codec_dai>;
		simple-audio-card,widgets = "Speaker", "Speakers",
					    "Microphone", "Internal Mic";
		simple-audio-card,routing = "Speakers", "SPKOUT",
					    "DMIC1A", "Internal Mic",
					    "DMIC1B", "Internal Mic";
		simple-audio-card,pin-switches = "Speakers";

		simple-audio-card,cpu {
			sound-dai = <&mca0>;
		};

		codec_dai: simple-audio-card,codec {
			sound-dai = <&cs42l81>;
		};
	};

	gpio-keys {
		compatible = "gpio-keys";

		button-home {
			label = "Home Button";
			gpios = <&pinctrl 2 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_HOMEPAGE>;
			wakeup-source;
		};

		button-power {
			label = "Power Button";
			gpios = <&pinctrl 3 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_POWER>;
			wakeup-source;
		};

		button-voldown {
			label = "Volume Down";
			gpios = <&pinctrl 4 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_VOLUMEDOWN>;
		};

		button-volup {
			label = "Volume Up";
			gpios = <&pinctrl 5 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_VOLUMEUP>;
		};

		switch-mute {
			label = "Mute Switch";
			gpios = <&pinctrl 110 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_MUTE>;
		};
	};

	/*
	 * Smart Cover hall sensors: D2089 GPIO 12 ("halleffect") and 10
	 * ("halleffect1") in the ADT /buttons node, the same lines as on the
	 * iPad Air 2. Line 12 is reported, active low as on the Air 2 and the
	 * iPad 6: on a J71 it reads low while the cover is closed and high
	 * while it is open. Reported as SW_MACHINE_COVER, not as a lid
	 * switch, so that closing the cover doesn't suspend the system.
	 * Polled: which PMU event a line raises is not established on the
	 * D2089, so the cover doesn't wake the system.
	 */
	smart-cover {
		compatible = "gpio-keys-polled";
		poll-interval = <50>;
		label = "iPad Smart Cover";

		cover-switch {
			label = "Smart Cover (PMIC GPIO 12)";
			gpios = <&pmu_events 12 GPIO_ACTIVE_LOW>;
			linux,input-type = <EV_SW>;
			linux,code = <SW_MACHINE_COVER>;
			debounce-interval = <50>;
		};
	};
};

&framebuffer0 {
	power-domains = <&ps_disp0 &ps_dp>;
};

&i2c0 {
	status = "okay";

	pmic@3c {
		compatible = "apple,anya-pmic", "apple,i2c-pmic";
		reg = <0x3c>;
		#address-cells = <1>;
		#size-cells = <1>;

		rtc@5c0 {
			compatible = "apple,anya-pmic-rtc", "apple,amber-pmic-rtc";
			reg = <0x5c0 0x10>;
			nvmem-cells = <&rtc_offset>;
			nvmem-cell-names = "rtc_offset";
		};

		backlight@600 {
			compatible = "apple,anya-pmic-bl";
			reg = <0x600 0x2>;
		};

		nvmem@4000 {
			compatible = "apple,pmic-nvmem";
			reg = <0x4000 0x28>;

			nvmem-layout {
				compatible = "fixed-layout";
				#address-cells = <1>;
				#size-cells = <1>;

				rtc_offset: rtc-offset@4 {
					reg = <0x4 0x4>;
				};
			};
		};
	};
};

&spi3 {
	/* ADT function-spi_cs0 */
	cs-gpios = <&pinctrl 99 GPIO_ACTIVE_LOW>;
	status = "okay";

	cs42l81: audio-codec@0 {
		compatible = "cirrus,cs42l81";
		reg = <0>;
		spi-max-frequency = <100000>;
		clocks = <&mca0>;
		clock-names = "mclk";
		/* ADT function-spkr_mute */
		mute-gpios = <&pinctrl 94 GPIO_ACTIVE_LOW>;
		cirrus,speaker-max-gain = <(-300)>;
		#sound-dai-cells = <0>;
	};
};

/*
 * Lightning charging, at the D2089's registers as iOS 12
 * AppleD2089PMUPowerSource uses them: connection and charger state at
 * 0x60, the input-current limit at 0x4c0, the ADC at 0x500.
 */
&{/soc/i2c@20a110000/pmic@3c} {
	/* The PMU event line, from the ADT pmu node: AP GPIO 103. */
	pmu_events: interrupt-controller {
		compatible = "apple,d2089-pmic-gpio";
		interrupt-controller;
		#interrupt-cells = <2>;
		interrupts-extended = <&pinctrl 103 IRQ_TYPE_LEVEL_LOW>;
		gpio-controller;
		#gpio-cells = <2>;
		/*
		 * Of the 17 lines only the Bluetooth power enable (2) and the
		 * Smart Cover hall sensors, 10 and 12, are exposed. The others
		 * stay as iBoot left them: the Wi-Fi reset (3, apple-a7-wlan
		 * owns it), the battery gauge (5) and, on the cellular boards,
		 * the baseband's (4, 8, 16), by Apple's device trees.
		 */
		gpio-reserved-ranges = <0 2>, <3 7>, <11 1>, <13 4>;
	};

	/*
	 * The ADT's charger node allows 0x960 = 2400 mA of input on every iPad Air.
	 * The maximum here is the highest input limit measured on an A7
	 * so far: 1500 mA (0x72) charged an iPad mini 2's battery at +958 mA
	 * from a Mac's CDP port, at 31 C. Before that, 1050 mA (0x4e)
	 * charged a J72's battery at +279 to +423 mA under the desktop, at
	 * 36 C, in thisiscamk's ten-minute run.
	 */
	tristar_charger: charger@60 {
		compatible = "apple,d2089-tristar-charger";
		reg = <0x60 0x0d>, <0x4c0 0x01>, <0x500 0x04>;
		reg-names = "status", "control", "adc";
		interrupt-parent = <&pmu_events>;
		/*
		 * The PMU line, ADC done and the D2089's plug event (event 0),
		 * which wakes the system when the source changes during sleep.
		 */
		interrupts = <112 IRQ_TYPE_EDGE_RISING>,
			     <89 IRQ_TYPE_EDGE_RISING>,
			     <0 IRQ_TYPE_EDGE_RISING>;
		apple,tristar = <&tristar>;
		input-current-limit-microamp = <1500000>;

		/* The charger decides when USB data may come on. */
		port {
			tristar_charger_usb: endpoint {
				remote-endpoint = <&usbdev_role>;
			};
		};
	};
};

&i2c2 {
	status = "okay";

	/* The Lightning port controller, from the ADT i2c2/tristar node. */
	tristar: port-controller@1a {
		compatible = "nxp,cbtl1610";
		reg = <0x1a>;
	};
};

/* Tell the Lightning charger what the USB host allows. */
&usbdev {
	usb-psy-name = "lightning";
	usb-role-switch;

	port {
		usbdev_role: endpoint {
			remote-endpoint = <&tristar_charger_usb>;
		};
	};
};

/ {
	/*
	 * The BCM43241 Wi-Fi radio on HSIC, where the device trees of
	 * the J71, J72 and J73 put it (/arm-io/usb-complex/usb-ehci0/wlan):
	 * EHCI0 root port 3, its HSIC PHY at usb-complex +0x50, HOST_READY
	 * on GPIO 163, DEVICE_READY on GPIO 164 and the reset on the D2089's
	 * GPIO3. apple-a7-wlan owns it.
	 */
	wifi@20c000050 {
		compatible = "apple,s5l8960x-hsic-wlan";
		reg = <0x2 0x0c000050 0x0 0x10>, <0x2 0x0c200000 0x0 0x10000>;
		reg-names = "phy", "ehci";
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 163 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_hsic1_phy>;
		apple,ehci-port = <3>;
		host-ready-gpios = <&pinctrl 163 GPIO_ACTIVE_HIGH>;
		device-ready-gpios = <&pinctrl 164 GPIO_ACTIVE_HIGH>;
	};
};


/*
 * The BCM4324B5's Bluetooth on UART1, from the bluetooth node below
 * /arm-io/uart1 in the J71, J72 and J73 device trees, which agree:
 * power enable on the D2089's GPIO 2, BT_WAKE on AP GPIO 7, H4 at a
 * transport-speed of 3 Mbit/s. The controller starts at 115,200 baud,
 * where the Patchram loads; hci_bcm then switches the link to 1.5 Mbit/s,
 * the fastest the A7 UART reaches exactly from its 24 MHz reference with
 * 16x oversampling. The ADT names no host wake line; the D2089's PMU
 * event 7 is named "bluetooth" and is not used.
 * m1n1 adds the device address through the bluetooth0 alias.
 */
/ {
	aliases {
		bluetooth0 = &bluetooth;
		serial1 = &serial1;
		serial5 = &serial5;
	};
};

&serial1 {
	pinctrl-0 = <&uart1_pins>;
	pinctrl-names = "default";
	uart-has-rtscts;
	status = "okay";

	bluetooth: bluetooth {
		compatible = "apple,s5l8960x-bcm4324b5-bt";
		current-speed = <115200>;
		max-speed = <1500000>;
		shutdown-gpios = <&pmu_events 2 GPIO_ACTIVE_HIGH>;
		device-wakeup-gpios = <&pinctrl 7 GPIO_ACTIVE_HIGH>;
	};
};

/*
 * The touchscreen: an N1 on SPI2, the same in the J71, J72 and J73 device
 * trees (/arm-io/spi2/multi-touch, multi-touch,j72): attention on GPIO 111,
 * reset on GPIO 15, display sync on pin 119, the D2089's analog and core
 * supplies. All three ship the same J72.mtprops, so the firmware is the
 * j72 one on each. The loader adds the unit's calibration through the
 * touchscreen0 alias.
 */
/ {
	aliases {
		touchscreen0 = &touchscreen; /* Used by loader */
	};
};

&pinctrl {
	spi2_sleep_pins: spi2-sleep-pins {
		pinmux = <APPLE_PINMUX(79, 0)>;
	};

	touch_sync_active: touch-sync-active-pins {
		pinmux = <APPLE_PINMUX(119, 1)>;
	};

	touch_sync_inactive: touch-sync-inactive-pins {
		pinmux = <APPLE_PINMUX(119, 0)>;
	};
};

&{/soc/i2c@20a110000/pmic@3c} {
	touch_analog: regulator-touch-analog {
		compatible = "apple,d2089-touch-analog-regulator";
		regulator-name = "touch-analog";
	};

	touch_core: regulator-touch-core {
		compatible = "apple,d2089-touch-core-regulator";
		regulator-name = "touch-core";
	};
};

&touchclk {
	status = "okay";
};

&spi2 {
	pinctrl-names = "default", "sleep";
	pinctrl-1 = <&spi2_sleep_pins>;
	status = "okay";

	touchscreen: touchscreen@0 {
		compatible = "apple,j72-touchscreen";
		reg = <0>;
		spi-max-frequency = <1000000>;
		interrupt-parent = <&pinctrl>;
		interrupts = <111 IRQ_TYPE_EDGE_FALLING>;
		attn-gpios = <&pinctrl 111 GPIO_ACTIVE_LOW>;
		reset-gpios = <&pinctrl 15 GPIO_ACTIVE_LOW>;
		clocks = <&touchclk>;
		ana-supply = <&touch_analog>;
		core-supply = <&touch_core>;
		pinctrl-names = "display-sync-active", "display-sync-inactive";
		pinctrl-0 = <&touch_sync_active>;
		pinctrl-1 = <&touch_sync_inactive>;
		touchscreen-size-x = <14621>;
		touchscreen-size-y = <19539>;
		touchscreen-inverted-y;
		firmware-name = "apple/j72-fwstart.z2fw";
		/* apple,z2-cal-blob: the unit's calibration, filled in by the loader */
	};
};

/*
 * The ambient light sensor: a CT819 at 0x39, on i2c0 or on i2c3. Apple's
 * device trees of the J71, J72 and J73 carry both (i2c0/als-i2c0 and
 * i2c3/als-i2c3, each with a proximity sensor beside it, interrupt
 * GPIO 6) and iOS probes for the one fitted, so both are described: the
 * absent one fails its chip ID read. Their alsCalibration is zero-filled,
 * with no SysCfg reference, so the sensor reports uncalibrated lux and has
 * no als0 alias for the loader.
 */
&i2c0 {
	light-sensor@39 {
		compatible = "apple,ct819", "amstaos,tsl2581";
		reg = <0x39>;
		interrupts-extended = <&pinctrl 6 IRQ_TYPE_LEVEL_LOW>;
	};
};

&i2c3 {
	status = "okay";

	light-sensor@39 {
		compatible = "apple,ct819", "amstaos,tsl2581";
		reg = <0x39>;
		interrupts-extended = <&pinctrl 6 IRQ_TYPE_LEVEL_LOW>;
	};
};

/*
 * The M7 motion coprocessor on UART4 (Apple's /arm-io/uart4/oscar, the same
 * on every A7 iPad), with the accelerometer, gyroscope and compass behind
 * it. Its supplies are D2089 switches (ADT oscar_power1, oscar_power2 and
 * sensor_power) and its reset is AP GPIO 66, active low (ADT flags 0x1;
 * seen on the J71).
 */
&{/soc/i2c@20a110000/pmic@3c} {
	oscar_core: regulator-oscar-core {
		compatible = "apple,d2089-oscar-core-regulator";
		regulator-name = "oscar-core";
	};

	oscar_io: regulator-oscar-io {
		compatible = "apple,d2089-oscar-io-regulator";
		regulator-name = "oscar-io";
	};

	oscar_sensors: regulator-oscar-sensors {
		compatible = "apple,d2089-oscar-sensors-regulator";
		regulator-name = "oscar-sensors";
	};
};

&serial4 {
	status = "okay";
	pinctrl-0 = <&uart4_pins>;
	pinctrl-names = "default";

	motion-coprocessor {
		compatible = "apple,s5l8960x-oscar";
		core-supply = <&oscar_core>;
		io-supply = <&oscar_io>;
		sensors-supply = <&oscar_sensors>;
		reset-gpios = <&pinctrl 66 GPIO_ACTIVE_LOW>;
		/*
		 * Measured on a J71: flat screen up z = +1 g, upright (Home
		 * down) y = -1 g, landscape with Home on the right x = -1 g
		 * and with Home on the left x = +1 g. So +x points to the left
		 * edge, +y to the Home end and +z out of the screen. That is
		 * already iio-sensor-proxy's frame: with this matrix Omarchy A
		 * rotates correctly in all four orientations. The gyroscope
		 * has the same axes: a positive rate is a right-hand turn
		 * about the accelerometer's own axis, on all three.
		 */
		mount-matrix = "1", "0", "0",
			       "0", "1", "0",
			       "0", "0", "1";
	};
};

/*
 * The battery gauge on UART5's HDQ line: a BQ27540 by Apple's device tree
 * (/arm-io/uart5/gas-gauge), the same on every A7 iPad. It runs the gauge
 * firmware profile measured on the J72.
 */
&serial5 {
	status = "okay";

	onewire {
		compatible = "ti,hdq-uart";

		fuel-gauge {
			compatible = "apple,j72-bq27545", "ti,bq27545-hdq";
		};
	};
};

/* The boot loader set up the display; nothing restores it after power loss. */
&ps_disp0 {
	apple,always-on;
	apple,manual-pm;
};

&ps_dp {
	apple,always-on;
	apple,manual-pm;
};
