/*
 * Apple iPad Air  common device tree
 * Based on A7 (APL5698), up to 1.4GHz
 *
 * Copyright (c) 2022, Konrad Dybcio <konradybcio@kernel.org>
 */

#include "s5l8960x.dtsi"
#include "s5l8960x-common.dtsi"
#include "s5l8965x-opp.dtsi"
#include <dt-bindings/input/input.h>

/ {
	chassis-type = "tablet";

	/*
	 * The speakers: the CS42L81 on SPI3 (control) and MCA0 (data), as in
	 * Apple's /arm-io/spi3/audio-codec and /arm-io/mca0/audio-codec, the
	 * same in the J71, J72 and J73 trees. The codec drives both speakers
	 * as one stereo pair. Headphones and microphones are not described
	 * yet.
	 */
	sound {
		compatible = "simple-audio-card";
		simple-audio-card,name = "iPad Air Speakers";
		simple-audio-card,format = "i2s";
		simple-audio-card,bitclock-master = <&codec_dai>;
		simple-audio-card,frame-master = <&codec_dai>;
		simple-audio-card,widgets = "Speaker", "Speakers";
		simple-audio-card,routing = "Speakers", "SPKOUT";
		simple-audio-card,pin-switches = "Speakers";

		simple-audio-card,cpu {
			sound-dai = <&mca0>;
		};

		codec_dai: simple-audio-card,codec {
			sound-dai = <&cs42l81>;
		};
	};

	gpio-keys {
		compatible = "gpio-keys";

		button-home {
			label = "Home Button";
			gpios = <&pinctrl 2 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_HOMEPAGE>;
			wakeup-source;
		};

		button-power {
			label = "Power Button";
			gpios = <&pinctrl 3 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_POWER>;
			wakeup-source;
		};

		button-voldown {
			label = "Volume Down";
			gpios = <&pinctrl 4 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_VOLUMEDOWN>;
		};

		button-volup {
			label = "Volume Up";
			gpios = <&pinctrl 5 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_VOLUMEUP>;
		};

		switch-mute {
			label = "Mute Switch";
			gpios = <&pinctrl 110 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_MUTE>;
		};
	};
};

&framebuffer0 {
	power-domains = <&ps_disp0 &ps_dp>;
};

&i2c0 {
	status = "okay";

	pmic@3c {
		compatible = "apple,anya-pmic", "apple,i2c-pmic";
		reg = <0x3c>;
		#address-cells = <1>;
		#size-cells = <1>;

		rtc@5c0 {
			compatible = "apple,anya-pmic-rtc", "apple,amber-pmic-rtc";
			reg = <0x5c0 0x10>;
			nvmem-cells = <&rtc_offset>;
			nvmem-cell-names = "rtc_offset";
		};

		backlight@600 {
			compatible = "apple,anya-pmic-bl";
			reg = <0x600 0x2>;
		};

		nvmem@4000 {
			compatible = "apple,pmic-nvmem";
			reg = <0x4000 0x28>;

			nvmem-layout {
				compatible = "fixed-layout";
				#address-cells = <1>;
				#size-cells = <1>;

				rtc_offset: rtc-offset@4 {
					reg = <0x4 0x4>;
				};
			};
		};
	};
};

&spi3 {
	/* ADT function-spi_cs0 */
	cs-gpios = <&pinctrl 99 GPIO_ACTIVE_LOW>;
	status = "okay";

	cs42l81: audio-codec@0 {
		compatible = "cirrus,cs42l81";
		reg = <0>;
		spi-max-frequency = <100000>;
		clocks = <&mca0>;
		clock-names = "mclk";
		/* ADT function-spkr_mute */
		mute-gpios = <&pinctrl 94 GPIO_ACTIVE_LOW>;
		cirrus,speaker-max-gain = <(-300)>;
		#sound-dai-cells = <0>;
	};
};

/*
 * Lightning charging, at the D2089's registers as iOS 12
 * AppleD2089PMUPowerSource uses them: connection and charger state at
 * 0x60, the input-current limit at 0x4c0, the ADC at 0x500.
 */
&{/soc/i2c@20a110000/pmic@3c} {
	/* The PMU event line, from the ADT pmu node: AP GPIO 103. */
	pmu_events: interrupt-controller {
		compatible = "apple,d2089-pmic-gpio";
		interrupt-controller;
		#interrupt-cells = <2>;
		interrupts-extended = <&pinctrl 103 IRQ_TYPE_LEVEL_LOW>;
	};

	/*
	 * The ADT's charger node allows 0x960 = 2400 mA of input on every iPad Air.
	 * The maximum here is the highest input limit measured on an A7
	 * so far: 1050 mA (0x4e) charged a J72's battery at +279 to +423 mA
	 * under the desktop, at 36 C, in thisiscamk's ten-minute run.
	 */
	tristar_charger: charger@60 {
		compatible = "apple,d2089-tristar-charger";
		reg = <0x60 0x0d>, <0x4c0 0x01>, <0x500 0x04>;
		reg-names = "status", "control", "adc";
		interrupt-parent = <&pmu_events>;
		/*
		 * The PMU line and ADC done. No source events, as on the iPad
		 * Air 2: the charger's 100 ms poll of 0x60 sees plug and unplug.
		 */
		interrupts = <112 IRQ_TYPE_EDGE_RISING>,
			     <89 IRQ_TYPE_EDGE_RISING>;
		apple,tristar = <&tristar>;
		input-current-limit-microamp = <1050000>;

		/* The charger decides when USB data may come on. */
		port {
			tristar_charger_usb: endpoint {
				remote-endpoint = <&usbdev_role>;
			};
		};
	};
};

&i2c2 {
	status = "okay";

	/* The Lightning port controller, from the ADT i2c2/tristar node. */
	tristar: port-controller@1a {
		compatible = "nxp,cbtl1610";
		reg = <0x1a>;
	};
};

/* Tell the Lightning charger what the USB host allows. */
&usbdev {
	usb-psy-name = "lightning";
	usb-role-switch;

	port {
		usbdev_role: endpoint {
			remote-endpoint = <&tristar_charger_usb>;
		};
	};
};

/ {
	/*
	 * The BCM43241 Wi-Fi radio on HSIC, where the device trees of
	 * the J71, J72 and J73 put it (/arm-io/usb-complex/usb-ehci0/wlan):
	 * EHCI0 root port 3, its HSIC PHY at usb-complex +0x50, HOST_READY
	 * on GPIO 163, DEVICE_READY on GPIO 164 and the reset on the D2089's
	 * GPIO3. apple-a7-wlan owns it.
	 */
	wifi@20c000050 {
		compatible = "apple,s5l8960x-hsic-wlan";
		reg = <0x2 0x0c000050 0x0 0x10>, <0x2 0x0c200000 0x0 0x10000>;
		reg-names = "phy", "ehci";
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 163 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_hsic1_phy>;
		apple,ehci-port = <3>;
		host-ready-gpios = <&pinctrl 163 GPIO_ACTIVE_HIGH>;
		device-ready-gpios = <&pinctrl 164 GPIO_ACTIVE_HIGH>;
	};
};
